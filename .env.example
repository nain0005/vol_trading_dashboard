# Copy this file to .env and fill in your own values. Never commit .env.
ROBINHOOD_USERNAME=you@example.com
ROBINHOOD_PASSWORD=your-password

# Optional: if you have TOTP-based 2FA (Authy/Google Authenticator) set up on
# Robinhood, put the base32 secret here so login can be fully automated.
# Leave blank to be prompted for the SMS/app code interactively instead.
ROBINHOOD_TOTP_SECRET=

# Comma-separated list of tickers you consider "vol products" for the
# dedicated VIX/vol-ETP exposure view (edit to match what you actually trade).
VOL_TICKERS=VXX,UVXY,SVXY,VIXY,UVIX,SVIX

# Set to "true" to run entirely on synthetic data (app/demo_data.py) with no
# Robinhood connection and no login gate — this is what a public deployment
# (e.g. Streamlit Community Cloud) should use. Leave unset/false for your own
# real-money local use. See README's "Demo mode" section.
DEMO_MODE=false
